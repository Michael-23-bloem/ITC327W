@model EnquiriesViewModel
@{
    ViewData["Title"] = "Enquiries";
    ViewData["BodyClass"] = "page-enquiries";
}

<header class="page-head">
    <p class="eyebrow">Ask us anything</p>
    <h1>Enquiries</h1>
    <p class="page-lead">Send us a question about your event. We usually reply within 24 hours, and our answer appears here.</p>
</header>

@if (TempData["EnquirySent"] is string sent)
{
    <div class="alert alert-dark py-2" role="status">@sent</div>
}

@if (Model.Error != null)
{
    <div class="alert alert-warning py-2" role="alert">@Model.Error</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <section class="enquiry-form" aria-labelledby="askTitle">
            <h2 id="askTitle" class="enquiry-heading">New question</h2>

            <form asp-action="Send" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="6" maxlength="2000"
                              placeholder="e.g. Do you deliver to venues outside Johannesburg?"></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn w-100">Send question</button>

                <p class="form-text mt-3 mb-0">
                    Prefer to chat? <a href="https://wa.me/27833956705" target="_blank" rel="noopener noreferrer">WhatsApp 083 395 6705</a>
                </p>
            </form>
        </section>
    </div>

    <div class="col-lg-7">
        <section aria-labelledby="historyTitle">
            <h2 id="historyTitle" class="enquiry-heading">Your questions</h2>

            @if (!Model.Enquiries.Any())
            {
                <p class="text-muted">You haven't sent any questions yet.</p>
            }
            else
            {
                <ol class="enquiry-list">
                    @foreach (var e in Model.Enquiries)
                    {
                        <li class="enquiry">
                            <div class="enquiry-meta">
                                <span class="status-badge @(e.IsAnswered ? "status-answered" : "status-waiting")">
                                    @(e.IsAnswered ? "Answered" : "Waiting for reply")
                                </span>
                                <time datetime="@e.CreatedAt.ToString("yyyy-MM-dd")">@e.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                            </div>

                            <p class="enquiry-text">@e.Message</p>

                            @if (e.IsAnswered)
                            {
                                <div class="enquiry-reply">
                                    <p class="eyebrow">
                                        AkeaEvents replied
                                        @if (e.RespondedAt.HasValue)
                                        {
                                            <text>&middot; @e.RespondedAt.Value.ToLocalTime().ToString("d MMM yyyy")</text>
                                        }
                                    </p>
                                    <p class="enquiry-text">@e.Response</p>
                                </div>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}