@model FirstWebApp.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["BodyClass"] = "page-account bg-blur";
}

<div class="auth">
    <div class="auth-card">
        <p class="eyebrow center">Account help</p>
        <h1 class="auth-title">Choose a new password</h1>

        <div id="resetLinkError" class="alert alert-danger" role="alert" hidden>
            This reset link is invalid or has expired.
            <a asp-action="ForgotPassword" class="alert-link">Request a new one</a>.
        </div>

        <form id="resetForm" asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="AccessToken" />
            <input type="hidden" asp-for="RefreshToken" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100">Save new password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // The reset link ends with #access_token=…&refresh_token=…&type=recovery
        (function () {
            const access = document.getElementById("AccessToken");
            const refresh = document.getElementById("RefreshToken");
            if (access.value && refresh.value) return; // page shown again after a validation error

            const params = new URLSearchParams(window.location.hash.substring(1));

            if (params.get("type") === "recovery" && params.get("access_token") && params.get("refresh_token")) {
                access.value = params.get("access_token");
                refresh.value = params.get("refresh_token");
                history.replaceState(null, "", window.location.pathname); // hide the tokens from the address bar
            } else {
                document.getElementById("resetLinkError").hidden = false;
                document.getElementById("resetForm").hidden = true;
            }
        })();
    </script>
}