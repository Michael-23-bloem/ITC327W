@model FirstWebApp.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["BodyClass"] = "page-account bg-blur";
}

<div class="auth">
    <div class="auth-card">
        <p class="eyebrow center">Account help</p>
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-sub">Enter your email and we'll send you a link to choose a new one.</p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100">Send reset link</button>
        </form>

        <p class="auth-sub mt-3 mb-0"><a asp-action="Login">Back to sign in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}