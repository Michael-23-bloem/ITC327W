@inject FirstWebApp.Services.EstimateService Estimate
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    // True when the page being shown belongs to this navbar link
    bool IsCurrent(string controller, string? action = null) =>
        currentController == controller && (action == null || currentAction == action);
    // Classes and aria-current for a navbar link
    string NavClass(bool on) => on ? "nav-link active" : "nav-link";
    string? NavCurrent(bool on) => on ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AkeaEvents</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FirstWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/akea.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="akea @ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light site-nav">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo" aria-hidden="true"></span>AkeaEvents
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Home", "Index"))" aria-current="@NavCurrent(IsCurrent("Home", "Index"))"
                               asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Portfolio"))" aria-current="@NavCurrent(IsCurrent("Portfolio"))"
                               asp-area="" asp-controller="Portfolio" asp-action="Index">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Catalogue"))" aria-current="@NavCurrent(IsCurrent("Catalogue"))"
                               asp-area="" asp-controller="Catalogue" asp-action="Index">Catalogue</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Quotes"))" aria-current="@NavCurrent(IsCurrent("Quotes"))"
                               asp-area="" asp-controller="Quotes" asp-action="Index">My Quotes</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Faqs"))" aria-current="@NavCurrent(IsCurrent("Faqs"))"
                               asp-area="" asp-controller="Faqs" asp-action="Index">FAQs</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsCurrent("Home", "About"))" aria-current="@NavCurrent(IsCurrent("Home", "About"))"
                               asp-area="" asp-controller="Home" asp-action="About">About us</a>
                        </li>
                    </ul>
                    <a class="btn btn-dark btn-sm ms-lg-3 my-2 my-lg-0" asp-controller="Estimate" asp-action="Index">
                        Estimate (@Estimate.Count)
                    </a>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="@(ViewData["FullWidth"] is true ? "full-width" : "container")">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 AkeaEvents &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy (POPIA)</a>
        </div>
    </footer>

    <partial name="_FloatingContact" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>