@using System.Security.Claims

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link nav-user">@User.FindFirst(ClaimTypes.Email)?.Value</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="nav-link btn btn-link">Sign out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link nav-login" asp-controller="Account" asp-action="Login">Log in</a>
        </li>
    }
</ul>