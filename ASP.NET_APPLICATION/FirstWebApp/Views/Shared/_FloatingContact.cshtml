@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var botUrl = Config["Chatbot:EmbedUrl"];
    var hasBot = !string.IsNullOrWhiteSpace(botUrl) && botUrl.StartsWith("https://");
}

@* Floating contact buttons, bottom right on every page *@
<div class="floating-contact">

    @* The AI assistant (FastBots), shown inside our own panel *@
    <section class="assistant-panel @(hasBot ? "has-bot" : "")" id="assistantPanel" aria-labelledby="assistantTitle" hidden>
        <div class="assistant-head">
            <h2 id="assistantTitle">Décor Assistant</h2>
            <button type="button" class="assistant-close" data-assistant-close aria-label="Close the Décor Assistant">&times;</button>
        </div>

        @if (hasBot)
        {
            @* The bot only loads the first time the panel is opened (see site.js) *@
            <iframe class="assistant-frame" title="AkeaEvents Décor Assistant chat" data-src="@botUrl"></iframe>
        }
        else
        {
            <div class="assistant-body">
                <p class="assistant-bubble">Our assistant is taking a short break. Our team is happy to help on WhatsApp.</p>
                <a class="btn btn-dark btn-sm w-100" href="https://wa.me/27833956705?text=Hi%20AkeaEvents%2C%20I%27d%20like%20to%20ask%20about%20an%20event."
                   target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
            </div>
        }
    </section>

    @* AI assistant *@
    <button type="button" class="fab-row" data-assistant-toggle aria-controls="assistantPanel" aria-expanded="false">
        <span class="fab-label">Have a question? <strong>Ask our assistant</strong></span>
        <span class="fab-circle fab-assistant" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l1.8 4.6L18.5 9.5l-4.7 1.9L12 16l-1.8-4.6L5.5 9.5l4.7-1.9z" />
                <path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
            </svg>
        </span>
    </button>

    @* WhatsApp *@
    <a class="fab-row" href="~/images/icons/Print_Glyph_Green_CMYK_2026.svg"
       target="_blank" rel="noopener noreferrer">
        <span class="fab-label">Need help? <strong>Chat with us</strong></span>
        <span class="fab-circle fab-whatsapp" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z" />
            </svg>
        </span>
        <span class="visually-hidden">on WhatsApp (opens in a new tab)</span>
    </a>
</div>