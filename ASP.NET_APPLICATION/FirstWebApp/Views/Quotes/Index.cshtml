@model List<QuoteListItem>
@{
    ViewData["Title"] = "My Quotes";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="list-page">
    <h1 class="list-title">My Quotes</h1>
    <p class="list-sub">Track your quotation requests and bookings.</p>

    @if (TempData["QuoteMessage"] is string message)
    {
        <div class="alert alert-dark py-2" role="status">@message</div>
    }

    @if (ViewData["Error"] is string error)
    {
        <div class="alert alert-warning py-2" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty">
            <p>You don't have any quotation requests yet.</p>
            <a asp-controller="Catalogue" asp-action="Products" class="btn btn-sm">Get an instant estimate</a>
        </div>
    }
    else
    {
        <div class="quotes-wrap">
            <table class="quotes-table">
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Event</th>
                        <th scope="col">Event date</th>
                        <th scope="col">Total</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td>@q.OrderNumber</td>
                            <td>@q.EventType</td>
                            <td>@q.EventDate.ToString("dd MMM yyyy", inv)</td>
                            <td>@(q.Total is null ? "Pending" : Money.Rand(q.Total.Value))</td>
                            <td><span class="chip @(q.Highlight ? "chip-dark" : "")">@q.StatusLabel</span></td>
                            <td class="actions">
                                <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-outline btn-sm">View order</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>